# Salin ke .env lalu isi nilainya:  cp .env.example .env
# File .env berisi secret asli dan TIDAK ikut ter-commit (lihat .gitignore).

# === pgweb ===
# Connection string auto-connect. Contoh menunjuk service `postgres` di compose ini:
#   postgres://postgres@postgres:5432/dev?sslmode=disable
# Kalau menunjuk DB di luar compose (mis. di host), pakai host.docker.internal:
#   postgres://<user>:<password>@host.docker.internal:5433/<db>?sslmode=disable
PGWEB_DATABASE_URL=

# === 9Router (lokal) ===
# Generate:
#   echo "NINEROUTER_JWT_SECRET=$(openssl rand -hex 32)"
#   echo "NINEROUTER_API_KEY_SECRET=$(openssl rand -hex 32)"
#   echo "NINEROUTER_MACHINE_ID_SALT=$(openssl rand -hex 16)"
#   echo "NINEROUTER_INITIAL_PASSWORD=$(openssl rand -base64 12 | tr -d '/+=' | cut -c1-16)"
NINEROUTER_JWT_SECRET=
NINEROUTER_API_KEY_SECRET=
NINEROUTER_MACHINE_ID_SALT=
NINEROUTER_INITIAL_PASSWORD=
# Port dashboard/API -> http://localhost:<port>
NINEROUTER_PORT=20128
# true = endpoint /v1 wajib API key
NINEROUTER_REQUIRE_API_KEY=true
